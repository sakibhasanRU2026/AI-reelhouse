{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated REELHOUSE user profile with server-verified role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "clientId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin grant document keyed by UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "description": "Client brand profile, guidelines, social links, and approval preferences.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "company": { "type": "string", "maxLength": 160 },
        "industry": { "type": "string", "maxLength": 120 },
        "niche": { "type": "string", "maxLength": 120 },
        "targetAudience": { "type": "string", "maxLength": 500 },
        "brandGuidelines": { "type": "string", "maxLength": 3000 },
        "brandColors": { "type": "array" },
        "preferredFonts": { "type": "array" },
        "referenceLinks": { "type": "array" },
        "contentPreferences": { "type": "object" },
        "socialAccounts": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "ownerUid", "name", "status", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Dedicated production workspace bound to a client.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "defaultAspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"] },
        "defaultResolution": { "type": "string", "enum": ["export_1080p", "preview_720p"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "clientId", "ownerUid", "name", "defaultAspectRatio", "defaultResolution", "createdAt", "updatedAt"]
    },
    "ContentIdea": {
      "title": "ContentIdea",
      "description": "Content idea organized by niche and category with approval workflow.",
      "type": "object",
      "properties": {
        "ideaId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "hook": { "type": "string", "maxLength": 400 },
        "category": { "type": "string", "maxLength": 80 },
        "niche": { "type": "string", "maxLength": 80 },
        "tags": { "type": "array" },
        "referenceLinks": { "type": "array" },
        "notes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "rejected", "changes_requested"] },
        "reviewNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ideaId", "clientId", "ownerUid", "title", "status", "createdAt", "updatedAt"]
    },
    "Script": {
      "title": "Script",
      "description": "Structured video script with hook, talking points, CTA, and caption.",
      "type": "object",
      "properties": {
        "scriptId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ideaId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "hook": { "type": "string", "maxLength": 500 },
        "talkingPoints": { "type": "array" },
        "cta": { "type": "string", "maxLength": 400 },
        "captionText": { "type": "string", "maxLength": 2200 },
        "estimatedDurationS": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "rejected", "changes_requested"] },
        "reviewNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scriptId", "clientId", "ownerUid", "title", "status", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "End-to-end content project linking client, idea, script, footage, instructions, and status.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "ideaId": { "type": "string", "maxLength": 128 },
        "scriptId": { "type": "string", "maxLength": 128 },
        "sourceAssetId": { "type": "string", "maxLength": 128 },
        "referenceAssetId": { "type": "string", "maxLength": 128 },
        "referenceMetrics": { "type": "object" },
        "editingInstructions": { "type": "object" },
        "targetAspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"] },
        "targetDurationS": { "type": "number" },
        "captionPreferences": { "type": "object" },
        "deadline": { "type": "string", "maxLength": 40 },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Idea Approval",
            "Script Approval",
            "Awaiting Footage",
            "Ready for Editing",
            "Rendering",
            "Awaiting Review",
            "Revision Requested",
            "Re-rendering",
            "Final Approval",
            "Ready for Publishing",
            "Published",
            "Failed"
          ]
        },
        "latestVersionNumber": { "type": "number" },
        "latestJobId": { "type": "string", "maxLength": 128 },
        "approvedVersionNumber": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "title", "clientId", "ownerUid", "status", "targetAspectRatio", "latestVersionNumber", "createdAt", "updatedAt"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Metadata for uploaded raw or reference video stored outside Firestore.",
      "type": "object",
      "properties": {
        "assetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "kind": { "type": "string", "enum": ["source", "reference"] },
        "filename": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mimeType": { "type": "string", "maxLength": 80 },
        "sizeBytes": { "type": "number" },
        "durationS": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "storageProvider": { "type": "string", "enum": ["local_temp", "r2"] },
        "available": { "type": "boolean" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "referenceAnalysis": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["assetId", "projectId", "clientId", "ownerUid", "kind", "filename", "storageProvider", "available", "createdAt"]
    },
    "RenderJob": {
      "title": "RenderJob",
      "description": "Synced render execution record for a project version.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "versionNumber": { "type": "number" },
        "status": { "type": "string", "enum": ["queued", "rendering", "completed", "failed"] },
        "progress": { "type": "number" },
        "error": { "type": "string", "maxLength": 1000 },
        "durationS": { "type": "number" },
        "resolutionPreset": { "type": "string", "enum": ["export_1080p", "preview_720p"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "ownerUid", "status", "progress", "createdAt", "updatedAt"]
    },
    "VideoVersion": {
      "title": "VideoVersion",
      "description": "Immutable video version snapshot requiring fresh client approval.",
      "type": "object",
      "properties": {
        "versionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "versionNumber": { "type": "number" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instructions": { "type": "object" },
        "revisionNotes": { "type": "string", "maxLength": 1000 },
        "approvalStatus": { "type": "string", "enum": ["pending_review", "approved", "rejected", "revision_requested"] },
        "outputAvailable": { "type": "boolean" },
        "durationS": { "type": "number" },
        "aspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"] },
        "resolutionPreset": { "type": "string", "enum": ["export_1080p", "preview_720p"] },
        "approvedBy": { "type": "string", "maxLength": 320 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["versionId", "projectId", "clientId", "ownerUid", "versionNumber", "jobId", "approvalStatus", "outputAvailable", "createdAt", "updatedAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Timestamped or general client feedback attached to a video version.",
      "type": "object",
      "properties": {
        "feedbackId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "versionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "versionNumber": { "type": "number" },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 320 },
        "timestampS": { "type": "number" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "matchedRules": { "type": "array" },
        "clarificationNeeded": { "type": "boolean" },
        "triggeredRevisionJobId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["open", "applied", "needs_clarification", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["feedbackId", "projectId", "versionId", "clientId", "ownerUid", "authorUid", "comment", "status", "createdAt", "updatedAt"]
    },
    "Approval": {
      "title": "Approval",
      "description": "Immutable approval/rejection decision record for ideas, scripts, and video versions.",
      "type": "object",
      "properties": {
        "approvalId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["idea", "script", "video_version"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "versionNumber": { "type": "number" },
        "decision": { "type": "string", "enum": ["approved", "rejected", "revision_requested"] },
        "note": { "type": "string", "maxLength": 1000 },
        "decidedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decidedByEmail": { "type": "string", "maxLength": 320 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["approvalId", "targetType", "targetId", "clientId", "ownerUid", "decision", "decidedByUid", "createdAt"]
    },
    "PublishingRecord": {
      "title": "PublishingRecord",
      "description": "Content calendar & platform publishing preparation record.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "versionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "versionNumber": { "type": "number" },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "platform": { "type": "string", "enum": ["instagram", "tiktok"] },
        "caption": { "type": "string", "maxLength": 2200 },
        "hashtags": { "type": "array" },
        "templateName": { "type": "string", "maxLength": 80 },
        "plannedDate": { "type": "string", "maxLength": 20 },
        "readiness": { "type": "string", "enum": ["draft", "ready", "scheduled", "not_connected", "published"] },
        "integrationStatus": { "type": "string", "enum": ["not_connected", "connected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "projectId", "versionId", "clientId", "ownerUid", "title", "platform", "plannedDate", "readiness", "integrationStatus", "createdAt", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Chronological CRM audit activity entry.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 320 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 320 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "ownerUid", "actorUid", "action", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserAccount" }, "description": "User profiles and server-controlled roles" },
    "/admins/{adminId}": { "schema": { "$ref": "#/entities/AdminRecord" }, "description": "Trusted admin lookup documents" },
    "/clients/{clientId}": { "schema": { "$ref": "#/entities/Client" }, "description": "Client brand workspaces" },
    "/workspaces/{workspaceId}": { "schema": { "$ref": "#/entities/Workspace" }, "description": "Client production workspaces" },
    "/contentIdeas/{ideaId}": { "schema": { "$ref": "#/entities/ContentIdea" }, "description": "Content ideas pending/approved" },
    "/scripts/{scriptId}": { "schema": { "$ref": "#/entities/Script" }, "description": "Video scripts and hooks" },
    "/projects/{projectId}": { "schema": { "$ref": "#/entities/Project" }, "description": "Content production projects" },
    "/assets/{assetId}": { "schema": { "$ref": "#/entities/Asset" }, "description": "Uploaded source and reference asset metadata" },
    "/renderJobs/{jobId}": { "schema": { "$ref": "#/entities/RenderJob" }, "description": "Render jobs linked to projects" },
    "/videoVersions/{versionId}": { "schema": { "$ref": "#/entities/VideoVersion" }, "description": "Immutable video cut versions" },
    "/feedback/{feedbackId}": { "schema": { "$ref": "#/entities/Feedback" }, "description": "Client timestamped review feedback" },
    "/approvals/{approvalId}": { "schema": { "$ref": "#/entities/Approval" }, "description": "Audit records of approvals and rejections" },
    "/publishingRecords/{recordId}": { "schema": { "$ref": "#/entities/PublishingRecord" }, "description": "Scheduled social publishing prep records" },
    "/activityLogs/{logId}": { "schema": { "$ref": "#/entities/ActivityLog" }, "description": "CRM activity feed entries" }
  }
}
